    {
      "name": "Errores",
      "description": "Taller de errores y validaciones: todos los errores con el formato { error: { code, message } }. E12 y E13 solo aplican con el servidor sin JWT_SECRET en produccion y con la base apagada.",
      "item": [
        {
          "name": "E01 Zod con dos campos malos - 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('Formato { error: { code: \"VALIDATION_ERROR\", message } }', () => {",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(e.message).to.be.a('string');",
                  "});",
                  "pm.test('Zod reporta los dos campos', () => {",
                  "  const campos = pm.response.json().error.details.map(d => d.campo);",
                  "  pm.expect(campos).to.include.members(['name', 'capacity']);",
                  "});"
                ]
