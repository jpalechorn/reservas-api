# Copiar este archivo como .env y reemplazar los valores.
# El archivo .env no se sube al repositorio.

# Conexión a PostgreSQL que usa Prisma.
# PostgreSQL instalado en Windows: puerto 5432.
# PostgreSQL con Docker (docker compose up -d): puerto 5433.
DATABASE_URL="postgresql://postgres:CLAVE@localhost:5432/reservas?schema=public"

# Credenciales del contenedor (solo si se usa docker compose).
# Deben coincidir con las de DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CLAVE
POSTGRES_DB=reservas

# Servidor
PORT=3000

# Autenticación
JWT_SECRET="cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="8h"
